{
  "name": "lockodoro",
  "productName": "Lockodoro",
  "version": "1.0.0",
  "description": "A tiny split-flap pomodoro timer. Press start. Lock in.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable"
  },
  "build": {
    "appId": "com.lockodoro.app",
    "productName": "Lockodoro",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*"
    ],
    "win": {
      "target": "portable",
      "signAndEditExecutable": false
    }
  },
  "devDependencies": {
    "@fontsource/eb-garamond": "^5.3.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  }
}
